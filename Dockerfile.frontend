# ==========================================
# Frontend Multi-Stage Dockerfile for VESLocal
# ==========================================

# Stage 1: Build the React + Vite static bundle
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY package.json package-lock.json ./

# Install clean dependencies
RUN npm ci

# Copy application source files
COPY index.html vite.config.js ./
COPY public ./public
COPY src ./src

# Build production assets
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# Stage 2: Serve static bundle via high-performance Nginx Alpine
FROM nginx:alpine AS runner

# Remove default nginx html
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Custom Nginx configuration for React Router SPA history fallback
RUN echo 'server {' \
  '  listen 80;' \
  '  server_name localhost;' \
  '  location / {' \
  '    root /usr/share/nginx/html;' \
  '    index index.html index.htm;' \
  '    try_files $uri $uri/ /index.html;' \
  '  }' \
  '  error_page 500 502 503 504 /50x.html;' \
  '  location = /50x.html {' \
  '    root /usr/share/nginx/html;' \
  '  }' \
  '}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
