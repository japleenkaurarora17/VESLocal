# Backend Environment Variables — copy to backend/.env and fill in real values

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (required for persistent data)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret_minimum_32_chars
JWT_EXPIRES_IN=7d

# CORS allowed frontend origin (no trailing slash)
CLIENT_URL=http://localhost:5173
